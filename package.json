{
  "name": "iambmusic-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "validate:media": "node scripts/refresh-media.mjs --validate-cache",
    "verify": "npm run check && npm run validate:media",
    "build": "npm run verify && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^24.19.0",
    "astro": "^7.3.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
