---
import { getImage } from 'astro:assets';
import cutout from '../../assets/artist/portrait-cutout.png';
import type {
  Language,
  Profile,
  ProfileId,
  UiDictionary,
} from '../../data/types.ts';
import { localize } from '../../i18n/index.ts';
import Icon from '../ui/Icon.astro';
import { routePath } from '../../lib/routes.ts';

interface Props {
  profile: Profile;
  profileId: ProfileId;
  lang: Language;
  ui: UiDictionary;
}

const { profile, profileId, lang, ui } = Astro.props;

const cutoutAlt = {
  de: 'Porträt von Markus B.',
  en: 'Portrait of Markus B.',
};
const artworkAlt = cutoutAlt[lang];
const [titleHead = profile.name, ...titleTail] = profile.name.split(' ');
const titleRest = titleTail.join(' ');
const artwork = await getImage({ src: cutout, widths: [380, 640, 900] });
const artworkAvif = await getImage({
  src: cutout,
  widths: [380, 640, 900],
  format: 'avif',
});
const placeholder =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<section class="spotlight">
  <div class="copy">
    <h1>
      {titleRest ? (
        <>
          {titleHead} <span class="title-tail">{titleRest}</span>
        </>
      ) : (
        profile.name
      )}
    </h1>
    <p class="lead">{localize(profile.hero.lead, lang)}</p>
    <a class="discover" href={routePath(lang, profileId, 'music')}>
      <span class="discover-label">{ui.actions.discoverMusic}</span>
      <Icon name="arrow-right" size="1.1rem" />
    </a>
  </div>

  <div class="artwork cutout">
    <picture>
      <source
        media="(min-width: 60rem)"
        srcset={artworkAvif.srcSet.attribute}
        sizes="(max-width: 80rem) 21rem, 28rem"
        type="image/avif"
      />
      <source
        media="(min-width: 60rem)"
        srcset={artwork.srcSet.attribute}
        sizes="(max-width: 80rem) 21rem, 28rem"
        type="image/webp"
      />
      <img
        src={placeholder}
        alt={artworkAlt}
        width={artwork.attributes['width']}
        height={artwork.attributes['height']}
        fetchpriority="high"
      />
    </picture>
  </div>
</section>

<style>
  .spotlight {
    position: relative;
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-3);
    align-content: center;
    justify-items: start;
    max-inline-size: 34rem;
  }

  h1 {
    font-size: var(--step-title);
    font-stretch: 115%;
    line-height: 1.02;
  }

  .title-tail {
    white-space: nowrap;
  }

  @media (max-width: 26.8rem) {
    h1 {
      min-block-size: 2lh;
    }
  }

  .lead {
    max-inline-size: 58ch;
    color: var(--legend-quiet);
    font-size: var(--step-lead);
  }
  .discover {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-block-start: var(--space-2);
    color: var(--legend);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: var(--legend-tracking);
    text-transform: uppercase;
    text-decoration: none;
  }

  .discover-label {
    padding-block: 0.35rem;
    border-block-end: 2px solid var(--ink-field);
  }

  .discover :global(.icon-glyph) {
    transition: translate 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .discover:hover :global(.icon-glyph),
  .discover:focus-visible :global(.icon-glyph) {
    translate: 0.3rem 0;
  }

  .artwork {
    display: none;
  }

  .artwork :global(img) {
    display: block;
    inline-size: 100%;
    object-fit: contain;
    object-position: bottom right;
  }

  .cutout :global(img) {
    filter: grayscale(1) contrast(1.05);
  }

  @media (min-width: 60rem) {
    .spotlight {
      min-block-size: var(--spotlight-height);
      margin-block-start: calc((var(--header-height) + var(--intro-gap)) * -1);
      padding-block: calc(var(--header-height) + var(--intro-gap))
        var(--space-6);
      --artwork-size: clamp(19rem, 44%, 28rem);
    }

    .copy {
      max-inline-size: min(32rem, 100% - var(--artwork-size) - var(--space-4));
    }

    .artwork {
      display: block;
      position: absolute;
      inset-inline-end: 0;
      inline-size: var(--artwork-size);
      pointer-events: none;
    }

    .artwork :global(img) {
      block-size: 100%;
    }

    .cutout {
      inset-block: var(--header-height) -2.25rem;
    }
  }

  @media (min-width: 60rem) and (max-width: 80rem) {
    .spotlight {
      --artwork-size: clamp(15rem, 34%, 21rem);
    }

    .cutout {
      inset-block-end: 0;
    }
  }
</style>
