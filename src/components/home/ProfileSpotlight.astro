---
import { Image } from 'astro:assets';
import cutout from '../../assets/artist/portrait-cutout.png';
import type { Language, Profile, ProfileId, UiDictionary } from '../../data/types.ts';
import { localize } from '../../i18n/index.ts';
import { routePath } from '../../lib/routes.ts';

interface Props {
  profile: Profile;
  profileId: ProfileId;
  lang: Language;
  ui: UiDictionary;
}

const { profile, profileId, lang, ui } = Astro.props;

const cutoutAlt = { de: 'Freigestelltes Porträt von Markus B.', en: 'Cut-out portrait of Markus B.' };
const artworkAlt = cutoutAlt[lang];
const [titleHead = profile.name, ...titleTail] = profile.name.split(' ');
const titleRest = titleTail.join(' ');
---

<section class="spotlight">
  <div class="copy">
    <h1>
      {titleRest ? (
        <>
          {titleHead} <span class="title-tail">{titleRest}</span>
        </>
      ) : (
        profile.name
      )}
    </h1>
    <p class="lead">{localize(profile.hero.lead, lang)}</p>
    <a class="discover" href={routePath(lang, profileId, 'music')} aria-label={ui.actions.discoverMusic}>
      <span class="discover-word" aria-hidden="true">{ui.actions.discoverLabel}</span>
      <span class="discover-frame" aria-hidden="true">
        <span class="discover-corner corner-lt" />
        <span class="discover-corner corner-rt" />
        <span class="discover-corner corner-rb" />
        <span class="discover-corner corner-lb" />
      </span>
      <span class="discover-arrow arrow-left" aria-hidden="true" />
      <span class="discover-arrow arrow-right" aria-hidden="true" />
    </a>
  </div>

  <div class="artwork cutout">
    <Image
      src={cutout}
      alt={artworkAlt}
      widths={[380, 640, 900]}
      sizes="(min-width: 60rem) 30rem, 55vw"
    />
  </div>
</section>

<style>
  .spotlight {
    position: relative;
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-3);
    align-content: center;
    justify-items: start;
    max-inline-size: 34rem;
  }


  h1 {
    font-size: var(--step-title);
    font-stretch: 115%;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .title-tail {
    white-space: nowrap;
  }

  @media (max-width: 26.8rem) {
    h1 {
      min-block-size: 2lh;
    }
  }

  .lead {
    max-inline-size: 58ch;
    color: var(--legend-quiet);
    font-size: var(--step-lead);
  }
  .discover {
    position: relative;
    justify-self: center;
    text-decoration: none;
    display: grid;
    place-items: center;
    inline-size: 188px;
    block-size: 52px;
    margin-block-start: var(--space-2);
    border: 0;
    background: none;
    color: var(--legend);
    cursor: pointer;
  }

  .discover-word {
    z-index: 1;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
  }

  .discover-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 4px double var(--ink-field);
    box-shadow: inset 0 0 15px color-mix(in srgb, var(--ink-field) 30%, transparent);
    clip-path: polygon(
      24% 0%,
      76% 0%,
      100% 30%,
      100% 70%,
      76% 100%,
      24% 100%,
      0% 70%,
      0% 30%
    );
  }

  .discover-corner {
    position: absolute;
    inline-size: 52px;
    block-size: 52px;
    background: var(--ink-field);
    box-shadow: inset 1px 1px 8px color-mix(in srgb, var(--ink) 55%, transparent);
    transform: scale(1) rotate(45deg);
    transition: transform 200ms ease;
  }

  .corner-lt {
    inset-block-start: -25.5px;
    inset-inline-start: -33px;
  }

  .corner-rt {
    inset-block-start: -25.7px;
    inset-inline-start: 93%;
  }

  .corner-rb {
    inset-block-start: 45%;
    inset-inline-start: 90.5%;
  }

  .corner-lb {
    inset-block-start: 27.3px;
    inset-inline-start: -22px;
  }

  .discover-arrow {
    position: absolute;
    inset-block-start: 35%;
    inline-size: 11%;
    block-size: 30%;
    background: var(--ink-field);
    transition: left 200ms ease;
  }

  .arrow-left {
    left: -13.5%;
    clip-path: polygon(100% 0, 100% 100%, 0 50%);
  }

  .arrow-right {
    left: 102%;
    clip-path: polygon(100% 49%, 0 0, 0 100%);
  }

  .discover:hover .discover-corner,
  .discover:focus-visible .discover-corner {
    background: var(--ink);
    transform: scale(1.25) rotate(45deg);
  }

  .discover:hover .discover-frame,
  .discover:focus-visible .discover-frame {
    border-color: var(--ink);
    box-shadow: inset 0 0 26px color-mix(in srgb, var(--ink) 34%, transparent);
  }

  .discover:hover .discover-arrow,
  .discover:focus-visible .discover-arrow {
    background: var(--ink);
  }

  .discover:hover .arrow-right,
  .discover:focus-visible .arrow-right {
    left: -15%;
    animation: discover-arrow-right 600ms ease-in-out infinite alternate;
  }

  .discover:hover .arrow-left,
  .discover:focus-visible .arrow-left {
    left: 103%;
    animation: discover-arrow-left 600ms ease-in-out infinite alternate;
  }

  @keyframes discover-arrow-left {
    to {
      transform: translateX(10px);
    }
  }

  @keyframes discover-arrow-right {
    to {
      transform: translateX(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .discover-corner,
    .discover-arrow {
      transition: none;
    }

    .discover:hover .discover-corner,
    .discover:focus-visible .discover-corner {
      transform: scale(1) rotate(45deg);
    }

    .discover:hover .arrow-right,
    .discover:focus-visible .arrow-right {
      left: -13.5%;
      animation: none;
    }

    .discover:hover .arrow-left,
    .discover:focus-visible .arrow-left {
      left: 102%;
      animation: none;
    }
  }

  .artwork {
    display: none;
  }

  .artwork :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    object-fit: contain;
    object-position: bottom right;
  }

  .cutout :global(img) {
    filter: grayscale(1) contrast(1.05);
  }


  @media (min-width: 60rem) {
    .spotlight {
      min-block-size: var(--spotlight-height);
      margin-block-start: calc((var(--header-height) + var(--intro-gap)) * -1);
      padding-block: calc(var(--header-height) + var(--intro-gap)) var(--space-6);
    }

    .copy {
      max-inline-size: 32rem;
    }

    .discover {
      justify-self: start;
      margin-inline-start: 2rem;
    }

    .artwork {
      display: block;
      position: absolute;
      inset-block-end: 0;
      inset-inline-end: 0;
      inline-size: clamp(19rem, 44%, 28rem);
      block-size: calc(100% - var(--space-3));
      margin-block-end: 0;
      pointer-events: none;
    }

    .artwork :global(img) {
      block-size: 100%;
    }

    .cutout {
      inset-block: 0 -2.25rem;
      block-size: auto;
    }


  }

  @media (min-width: 60rem) and (max-width: 80rem) {
    .cutout {
      inset-block-end: 0;
      inline-size: clamp(15rem, 34%, 21rem);
    }
  }
</style>

