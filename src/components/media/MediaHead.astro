---
import type { UiDictionary } from '../../data/types.ts';
import Icon from '../ui/Icon.astro';

interface Props {
  ui: UiDictionary;
}

const { ui } = Astro.props;
---

<div
  class="media-head media-grid"
  data-sort-asc={ui.music.sortAsc}
  data-sort-desc={ui.music.sortDesc}
>
  <span class="index" aria-hidden="true">
    #
  </span>

  <button class="sort" type="button" data-sort="title">
    {ui.music.columns.title}
    <span class="sr-only" data-sort-state></span>
    <span class="caret" aria-hidden="true">
      <span data-caret="asc">
        <Icon name="caret-up" weight="bold" size="0.7rem" />
      </span>
      <span data-caret="desc">
        <Icon name="caret-down" weight="bold" size="0.7rem" />
      </span>
    </span>
  </button>

  <span class="source" aria-hidden="true">
    <span>{ui.music.columns.source}</span>
  </span>

  <button class="sort released" type="button" data-sort="released">
    {ui.music.columns.released}
    <span class="sr-only" data-sort-state></span>
    <span class="caret" aria-hidden="true">
      <span data-caret="asc">
        <Icon name="caret-up" weight="bold" size="0.7rem" />
      </span>
      <span data-caret="desc">
        <Icon name="caret-down" weight="bold" size="0.7rem" />
      </span>
    </span>
  </button>

  <span class="length" aria-hidden="true">
    {ui.music.columns.length}
  </span>
  <span />
</div>

<style>
  .media-head {
    padding-block: var(--space-2);
    border-block-end: var(--rule) solid var(--panel-rule);
    color: var(--legend-faint);
    font-size: var(--step-head);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .index {
    justify-self: center;
    font-variant-numeric: tabular-nums;
  }
</style>
