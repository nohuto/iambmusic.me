---
import { formatClock } from '../../lib/clock.ts';
import { Image } from 'astro:assets';
import type { Language, Profile, UiDictionary } from '../../data/types.ts';
import type { LibraryRow, LibrarySource } from '../../lib/library.ts';
import { routePath } from '../../lib/routes.ts';
import { sourceIcons, sourceNames } from '../../lib/sources.ts';
import { watchUrl } from '../../lib/youtube.ts';
import Icon from '../ui/Icon.astro';

interface Props {
  row: LibraryRow;
  position: number;
  eager?: boolean;
  profile: Profile;
  lang: Language;
  ui: UiDictionary;
}

const { row, position, eager, profile, lang, ui } = Astro.props;
const dateFormat = new Intl.DateTimeFormat(lang, { dateStyle: 'medium' });

const glyphs = {
  ...sourceIcons,
  local: 'music-notes',
} as const satisfies Record<LibrarySource, string>;

const names: Record<LibrarySource, string> = {
  ...sourceNames,
  local: ui.music.local,
};

const isLocal = row.source === 'local';
const playable = isLocal || row.playable;
const length =
  row.durationSeconds === null || !Number.isFinite(row.durationSeconds)
    ? '-'
    : formatClock(row.durationSeconds);
const released = row.publishedAt
  ? dateFormat.format(new Date(row.publishedAt))
  : '-';
const watch = row.videoId ? watchUrl(row.videoId) : null;
const thumbnailSet =
  row.thumbnail?.startsWith('https://i1.sndcdn.com/') &&
  row.thumbnail.endsWith('-large.jpg')
    ? `${row.thumbnail} 1x, ${row.thumbnail.replace('-large.', '-t200x200.')} 2x`
    : undefined;
const sourceLink = isLocal ? null : row.source === 'youtube' ? watch : row.url;
const sourceLinkLabel =
  row.source === 'youtube'
    ? ui.music.openYouTube
    : row.source === 'soundcloud'
      ? ui.music.openSoundCloud
      : ui.music.openExternal;
const share = `${new URL(routePath(lang, profile.id, 'music'), Astro.site ?? 'https://iambmusic.me').href}?focus=${encodeURIComponent(row.id)}`;
const menuId = `row-menu-${row.id.replace(/[^A-Za-z0-9]/g, '-')}`;
---

<div
  class="media-row media-grid"
  data-row-id={row.id}
  data-playable={playable ? '' : undefined}
>
  {playable ? (
    <button
      class="transport icon-action"
      type="button"
      data-row-play={row.id}
      data-play={ui.player.play}
      data-pause={ui.player.pause}
      aria-label={ui.player.play}
    >
      <span class="index" data-row-index aria-hidden="true">
        {position}
      </span>
      <span data-row-icon="play">
        <Icon name="play" weight="fill" size="0.95rem" />
      </span>
      <span data-row-icon="pause">
        <Icon name="pause" weight="fill" size="0.95rem" />
      </span>
      <span data-row-icon="waveform">
        <Icon name="waveform" weight="bold" size="1rem" />
      </span>
    </button>
  ) : (
    <a
      class="transport icon-action"
      href={row.url ?? undefined}
      aria-label={ui.music.openExternal}
      target="_blank"
      rel="noreferrer"
    >
      <span class="index" data-row-index aria-hidden="true">
        {position}
      </span>
      <span data-row-icon="open">
        <Icon name="arrow-square-out" size="0.95rem" />
      </span>
    </a>
  )}

  <button
    class="select"
    type="button"
    data-row-select={row.id}
    aria-label={row.title}
  >
    <span class="lead">
      <span class="shot">
        {row.thumbnail ? (
          <img
            src={row.thumbnail}
            srcset={thumbnailSet}
            alt=""
            width="320"
            height="180"
            loading={eager ? undefined : 'lazy'}
            decoding="async"
          />
        ) : (
          <Image
            src={profile.images.logo}
            alt=""
            width={54}
            densities={[1, 2, 3]}
          />
        )}
      </span>
      <span class="titles">
        <span class="title">{row.title}</span>
        {row.publishedAt && (
          <time class="rowmeta" datetime={row.publishedAt}>
            {released}
          </time>
        )}
      </span>
    </span>

    <span aria-hidden="true"></span>

    <span class="released">{released}</span>
    <span class="length">{length}</span>
  </button>

  {sourceLink ? (
    <a
      class="source source-link"
      href={sourceLink}
      target="_blank"
      rel="noreferrer"
    >
      <Icon name={glyphs[row.source]} size="1rem" />
      <span>{names[row.source]}</span>
    </a>
  ) : (
    <span class="source">
      <Icon name={glyphs[row.source]} size="1rem" />
      <span>{names[row.source]}</span>
    </span>
  )}

  {playable && (
    <div class="overflow">
      <button
        class="dots icon-action"
        type="button"
        popovertarget={menuId}
        aria-label={ui.music.rowMenu}
      >
        <Icon name="dots-three" weight="bold" size="1.05rem" />
      </button>

      <div class="row-menu" id={menuId} popover data-anchored-menu>
        <ul>
          <li>
            <button type="button" data-row-enqueue={row.id}>
              {ui.music.addToQueue}
            </button>
          </li>
          {sourceLink && (
            <li>
              <a href={sourceLink} target="_blank" rel="noreferrer">
                {sourceLinkLabel}
              </a>
            </li>
          )}
          <li>
            <button type="button" data-row-copy={share}>
              {ui.music.copyLink}
            </button>
          </li>
        </ul>
      </div>
    </div>
  )}
</div>

<style>
  .media-row {
    min-block-size: 3.5rem;
    border-radius: var(--radius-inner);
    color: var(--legend);
  }

  .transport,
  .dots {
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: 0;
    background: none;
    color: var(--legend-quiet);
    cursor: pointer;
  }

  .transport {
    color: var(--legend);
  }

  .select {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 2 / -2;
    grid-row: 1;
    align-items: center;
    gap: var(--space-3);
    min-inline-size: 0;
    padding-block: var(--space-2);
    border: 0;
    background: none;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }

  .media-row:hover {
    background: var(--panel-hover);
  }

  .media-row[data-row-selected] {
    background: var(--panel-hover);
  }

  .lead {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    min-inline-size: 0;
  }

  .shot {
    inline-size: 3.375rem;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-inner);
    overflow: hidden;
    background: var(--panel-recess);
  }

  .shot img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .titles {
    display: grid;
    gap: 2px;
    min-inline-size: 0;
  }

  .title {
    font-weight: 600;
    line-height: 1.35;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .rowmeta {
    color: var(--legend-faint);
    font-size: var(--step-0);
  }

  .source {
    z-index: 1;
    grid-column: 3;
    grid-row: 1;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-inline-size: 0;
    color: var(--legend-quiet);
    font-size: var(--step-0);
  }

  .source-link {
    text-decoration: none;
  }

  .source-link:hover,
  .source-link:focus-visible {
    color: var(--legend);
  }

  .released,
  .length {
    color: var(--legend-faint);
    font-size: var(--step-0);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .overflow {
    position: relative;
    grid-column: -2 / -1;
    grid-row: 1;
  }

  .row-menu {
    inline-size: 14rem;
    max-inline-size: calc(100vw - 1rem);
    padding: var(--space-1) 0;
  }

  .row-menu ul {
    display: grid;
    align-content: start;
  }

  .row-menu li:first-child {
    border-block-end: var(--rule) solid var(--panel-rule);
  }

  .row-menu :is(a, button) {
    display: flex;
    align-items: center;
    inline-size: 100%;
    min-block-size: 2rem;
    padding-inline: var(--space-3);
    border: 0;
    background: none;
    color: var(--legend);
    font-size: var(--step-nav);
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .row-menu :is(a, button):hover,
  .row-menu :is(a, button):focus-visible {
    background: var(--panel-hover);
  }
</style>
