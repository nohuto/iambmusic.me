---
import type { Language, UiDictionary } from '../../data/types.ts';
import type { LibraryRow } from '../../lib/library.ts';
import type { MediaLibrary, MediaSource } from '../../lib/media.ts';

interface Props {
  lang: Language;
  ui: UiDictionary;
  library: MediaLibrary;
  heading: string;
  lead: string;
  rows: readonly LibraryRow[];
  sources: readonly MediaSource[];
}

const { lang, ui, library, heading, lead, rows, sources } = Astro.props;

const dateFormat = new Intl.DateTimeFormat(lang, { dateStyle: 'medium' });
const format = (stamp: string | undefined) =>
  stamp ? dateFormat.format(new Date(stamp)) : null;

const overallDate = format(
  sources
    .map((source) => library.refreshedAt[source])
    .filter((value): value is string => Boolean(value))
    .sort()
    .at(-1),
);

const facts: Record<string, { count: number; date: string | null }> = {
  '': { count: rows.length, date: overallDate },
};
for (const source of sources) {
  const count = rows.filter((row) => row.source === source).length;
  if (count > 0)
    facts[source] = { count, date: format(library.refreshedAt[source]) };
}
const initial = facts[''];
---

<section class="banner">
  <div class="copy">
    <h1>{heading}</h1>
    <p class="lead">{lead}</p>
    <p
      class="facts"
      aria-live="polite"
      data-banner-facts
      data-sets={JSON.stringify(facts)}
    >
      <span data-facts-count data-label={ui.music.entries}>
        {initial?.count} {ui.music.entries}
      </span>
      <span
        class="dot"
        aria-hidden="true"
        data-facts-dot
        hidden={!initial?.date}
      >
        &#183;
      </span>
      <span
        data-facts-updated
        data-label={ui.video.updated}
        hidden={!initial?.date}
      >
        {ui.video.updated} {initial?.date}
      </span>
    </p>
  </div>
</section>

<style>
  .banner {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-block-end: var(--space-3);
  }

  .copy {
    display: grid;
    gap: var(--space-2);
    max-inline-size: 44rem;
  }

  .lead {
    color: var(--legend-quiet);
    font-size: var(--step-lead);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--legend-faint);
    font-size: var(--step-0);
  }

  @media (max-width: 60rem) {
    h1 {
      font-size: clamp(2rem, 9vw, 2.6rem);
    }

    .lead {
      font-size: var(--step-1);
    }
  }

  @media (min-width: 60rem) {
    .banner {
      padding-block-end: var(--space-5);
    }
  }
</style>
