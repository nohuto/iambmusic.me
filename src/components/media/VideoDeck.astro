---
import type { Language, Profile, ProfileId, UiDictionary } from '../../data/types.ts';
import type { LibraryRow } from '../../lib/library.ts';
import { routePath } from '../../lib/routes.ts';
import MediaHead from './MediaHead.astro';
import MediaRow from './MediaRow.astro';

interface Props {
  rows: readonly LibraryRow[];
  lang: Language;
  profile: Profile;
  profileId: ProfileId;
  ui: UiDictionary;
  heading: string;
}

const { rows, lang, profile, profileId, ui, heading } = Astro.props;
const moreHref = `${routePath(lang, profileId, 'music')}?source=youtube`;
---

<section class="panel deck" data-sortable aria-labelledby="deck-heading">
  <header class="panel-head">
    <h2 id="deck-heading">{heading}</h2>
    {rows.length > 0 && (
      <a class="more" href={moreHref}>
        {ui.actions.seeMore}
      </a>
    )}
  </header>

  {
    rows.length === 0 ? (
      <p class="empty">{ui.video.empty}</p>
    ) : (
      <>
        <MediaHead ui={ui} />

        <ul class="rows">
          {rows.map((row, position) => (
            <li
              data-media-row
              data-sort-title={row.title}
              data-sort-date={row.publishedAt ?? ''}
              data-sort-order={position}
            >
              <MediaRow row={row} position={position + 1} profile={profile} lang={lang} ui={ui} />
            </li>
          ))}
        </ul>

      </>
    )
  }
</section>

<style>
  .deck {
    position: relative;
    z-index: 1;
  }

  .rows {
    display: grid;
  }

  li + li {
    border-block-start: var(--rule) solid var(--panel-rule);
  }

</style>
