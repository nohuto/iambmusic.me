---
import type { Language, PageId, ProfileId, UiDictionary } from '../../data/types.ts';
import { languages } from '../../data/types.ts';
import { dictionaries } from '../../i18n/index.ts';
import { routePath } from '../../lib/routes.ts';
import Icon from '../ui/Icon.astro';

interface Props {
  lang: Language;
  profile: ProfileId;
  page: PageId;
  ui: UiDictionary;
}

const { lang, profile, page, ui } = Astro.props;
const flags: Record<Language, string> = { de: '🇩🇪', en: '🇬🇧' };
const menuId = 'language-menu';
---

<div class="language-switch">
  <button class="trigger" type="button" popovertarget={menuId} aria-label={ui.switches.language}>
    <span class="flag" aria-hidden="true">{flags[lang]}</span>
    <span class="full">{dictionaries[lang].languageName}</span>
    <span class="short" aria-hidden="true">{lang.toUpperCase()}</span>
    <Icon name="caret-down" size="0.8rem" />
  </button>

  <div class="menu" id={menuId} popover data-anchored-menu>
    <ul>
      {
        languages.map((option) => {
          const current = option === lang;
          return (
            <li>
              <a
                href={routePath(option, profile, page)}
                lang={option}
                hreflang={option}
                data-astro-reload
                aria-current={current ? 'true' : undefined}
              >
                <span class="flag" aria-hidden="true">
                  {flags[option]}
                </span>
                <span class="name">{dictionaries[option].languageName}</span>
                {current && (
                  <span class="state">
                    <Icon name="check" weight="bold" size="0.85rem" />
                    <span class="sr-only">{ui.switches.active}</span>
                  </span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<style>
  .language-switch {
    position: relative;
    display: flex;
  }

  .trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    block-size: var(--utility-height);
    padding-inline: var(--space-2);
    border: var(--rule) solid var(--panel-rule);
    border-radius: var(--radius);
    background: var(--panel-plate);
    color: var(--legend);
    font-size: var(--step-0);
    font-weight: 600;
    cursor: pointer;
  }

  .trigger:hover {
    border-color: var(--legend-faint);
  }

  .flag {
    font-size: 0.9rem;
    line-height: 1;
  }

  .short {
    display: none;
    letter-spacing: var(--legend-tracking);
  }

  .menu {
    position: fixed;
    inset: auto auto auto 0;
    margin: 0;
    inline-size: max-content;
    min-inline-size: 10rem;
    padding: 4px var(--space-2);
    border: var(--rule) solid var(--panel-rule);
    border-radius: var(--radius);
    background: var(--panel-plate);
    color: var(--legend);
    box-shadow: var(--shadow-plate);
    block-size: fit-content;
    max-block-size: calc(
      100dvh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px) - var(--space-5)
    );
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu:popover-open {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .menu ul {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .menu a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 2rem;
    padding-inline: var(--space-2);
    border-radius: var(--radius-inner);
    color: var(--legend);
    font-size: var(--step-nav);
    font-weight: 600;
    text-decoration: none;
  }

  .menu a:hover {
    background: var(--panel-ground);
  }

  .menu a[aria-current] .name {
    color: var(--ink);
  }

  .state {
    display: inline-flex;
    color: var(--ink);
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .full {
      display: none;
    }

    .short {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu:popover-open {
      animation: language-in 120ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @keyframes language-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>
