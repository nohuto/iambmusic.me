---
import { Image } from 'astro:assets';
import { aimbProfile } from '../../data/profiles/aimb.ts';
import { iambProfile } from '../../data/profiles/iamb.ts';
import type { Language, PageId, ProfileId, UiDictionary } from '../../data/types.ts';
import { routePath } from '../../lib/routes.ts';
import Icon from '../ui/Icon.astro';

interface Props {
  lang: Language;
  profile: ProfileId;
  page: PageId;
  ui: UiDictionary;
}

const { lang, profile, page, ui } = Astro.props;

const entries = [iambProfile, aimbProfile];
const active = entries.find((entry) => entry.id === profile) ?? iambProfile;
const menuId = 'profile-menu';
---

<div class="profile-menu">
  <button
    class="trigger"
    type="button"
    popovertarget={menuId}
    aria-label={ui.switches.profile}
  >
    <Image class="avatar" src={active.images.logo} alt="" width={28} height={28} />
    <span class="short">{active.shortName}</span>
    <Icon name="caret-down" size="0.9rem" />
  </button>

  <div class="menu" id={menuId} popover data-anchored-menu>
    <ul>
      {
        entries.map((entry) => {
          const current = entry.id === profile;
          return (
            <li>
              <a
                href={routePath(lang, entry.id, page)}
                data-astro-reload
                aria-current={current ? 'true' : undefined}
              >
                <Image class="avatar" src={entry.images.logo} alt="" width={28} height={28} />
                <span class="name">{entry.name}</span>
                {current && (
                  <span class="state">
                    <Icon name="check" weight="bold" size="0.9rem" />
                    <span class="sr-only">{ui.switches.active}</span>
                  </span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<style>
  .profile-menu {
    position: relative;
    display: flex;
  }

  .trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    block-size: var(--utility-height);
    padding-inline: 2px var(--space-2);
    border: var(--rule) solid var(--panel-rule);
    border-radius: var(--radius);
    background: var(--panel-plate);
    color: var(--legend);
    font-size: var(--step-nav);
    font-weight: 600;
    cursor: pointer;
  }

  .trigger:hover {
    border-color: var(--legend-faint);
  }

  .avatar {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 999px;
    object-fit: cover;
    flex: none;
  }

  .menu {
    position: fixed;
    inset: auto auto auto 0;
    margin: 0;
    inline-size: max-content;
    min-inline-size: 14rem;
    padding: 4px var(--space-2);
    border: var(--rule) solid var(--panel-rule);
    border-radius: var(--radius);
    background: var(--panel-plate);
    color: var(--legend);
    box-shadow: var(--shadow-plate);
    block-size: fit-content;
    max-block-size: calc(
      100dvh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px) - var(--space-5)
    );
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu:popover-open {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .menu ul {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .menu a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--touch);
    padding-inline: var(--space-2);
    border-radius: var(--radius-inner);
    color: var(--legend);
    font-size: var(--step-nav);
    font-weight: 600;
    text-decoration: none;
  }

  .menu a:hover {
    background: var(--panel-ground);
  }

  .menu a[aria-current] .name {
    color: var(--ink);
  }

  .state {
    display: inline-flex;
    color: var(--ink);
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu:popover-open {
      animation: menu-in 120ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>
