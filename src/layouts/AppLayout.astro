---
import { getImage } from 'astro:assets';
import archivoLatin from '../assets/fonts/archivo-latin.woff2?url';
import iambLogo from '../assets/profiles/iamb/logo.png';
import AppHeader from '../components/shell/AppHeader.astro';
import ThemeBootstrap from '../components/shell/ThemeBootstrap.astro';
import PanelBottomNav from '../components/shell/PanelBottomNav.astro';
import ProfileRail from '../components/shell/ProfileRail.astro';
import VideoStage from '../components/media/VideoStage.astro';
import SearchDialog from '../components/search/SearchDialog.astro';
import PlayerDock from '../components/player/PlayerDock.astro';
import type { Language, PageId, Profile, ProfileId } from '../data/types.ts';
import { getDictionary } from '../i18n/index.ts';
import { inlineJson } from '../lib/inline-json.ts';
import { ClientRouter } from 'astro:transitions';
import { getMusicSources, getSocialSources } from '../lib/library.ts';
import { absoluteUrl, alternateLinks, routePath } from '../lib/routes.ts';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  lang: Language;
  profile: ProfileId;
  activeProfile: Profile;
  page: PageId;
  title: string;
  description: string;
}

const { lang, profile, activeProfile, page, title, description } = Astro.props;
const musicSources = getMusicSources(activeProfile);
const socialSources = getSocialSources(profile);

const ui = getDictionary(lang);
const playbackId = ['playback', lang, profile].join('-');
const canonical = absoluteUrl(routePath(lang, profile, page), Astro.site);
const alternates = alternateLinks(profile, page);
const favicon = await getImage({
  src: iambLogo,
  width: 64,
  format: 'png',
});
const touchIcon = await getImage({
  src: iambLogo,
  width: 180,
  format: 'png',
});
const themeColors = {
  iamb: { light: '#ddd0b0', dark: '#241c07' },
  aimb: { light: '#c8d2e2', dark: '#0d1526' },
}[profile];
const locales = { de: 'de_DE', en: 'en_GB' };
const shareImage = await getImage({
  src: activeProfile.images.logo,
  width: 500,
  format: 'jpeg',
  background: themeColors.dark,
});
const profileData =
  page === 'home'
    ? inlineJson({
        '@context': 'https://schema.org',
        '@type': 'MusicGroup',
        name: activeProfile.name,
        url: canonical,
        image: absoluteUrl(shareImage.src, Astro.site),
        sameAs: activeProfile.platforms
          .map((platform) => platform.url)
          .filter((url) => !url.includes('/release/')),
      })
    : null;
---

<!doctype html>
<html lang={lang} data-profile={profile}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <ThemeBootstrap />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    {(['light', 'dark'] as const).map((scheme) => (
      <meta
        name="theme-color"
        media={`(prefers-color-scheme: ${scheme})`}
        content={themeColors[scheme]}
        data-light={themeColors.light}
        data-dark={themeColors.dark}
      />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={activeProfile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locales[lang]} />
    <meta
      property="og:locale:alternate"
      content={locales[lang === 'de' ? 'en' : 'de']}
    />
    <meta
      property="og:image"
      content={absoluteUrl(shareImage.src, Astro.site)}
    />
    <meta property="og:image:width" content="500" />
    <meta property="og:image:height" content="500" />
    <meta name="twitter:card" content="summary" />
    {profileData && (
      <script is:inline type="application/ld+json" set:html={profileData} />
    )}
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={absoluteUrl(alternate.path, Astro.site)}
      />
    ))}
    <ClientRouter fallback="swap" />
    <link
      rel="preload"
      href={archivoLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let rail = null;
        let musicSources = null;
        let socialSources = null;
        try {
          rail = localStorage.getItem('iambmusic-rail');
          musicSources = localStorage.getItem('iambmusic-music-sources');
          socialSources = localStorage.getItem('iambmusic-social-sources');
        } catch {}
        root.dataset.rail = rail === 'collapsed' ? 'collapsed' : 'expanded';
        root.dataset.musicSources =
          musicSources === 'collapsed' ? 'collapsed' : 'expanded';
        root.dataset.socialSources =
          socialSources === 'collapsed' ? 'collapsed' : 'expanded';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {ui.actions.skipToContent}
    </a>

    <div class="app">
      <ProfileRail
        lang={lang}
        profile={profile}
        activeProfile={activeProfile}
        page={page}
        ui={ui}
        musicSources={musicSources}
        socialSources={socialSources}
      />

      <div class="main">
        <AppHeader
          lang={lang}
          profile={profile}
          activeProfile={activeProfile}
          page={page}
          ui={ui}
        />

        <main id="main" class="stage" transition:animate="none">
          <slot />
        </main>

        <PanelBottomNav lang={lang} profile={profile} page={page} ui={ui} />
      </div>
    </div>

    <div class="playback" transition:persist={playbackId}>
      <VideoStage ui={ui} />
      <PlayerDock profile={activeProfile} profileId={profile} ui={ui} />
    </div>

    <SearchDialog lang={lang} profile={profile} ui={ui} />

    <script>
      import '../scripts/audio-player.ts';
      import '../scripts/section-swap.ts';
      import '../scripts/theme.ts';
      import '../scripts/search.ts';
      import '../scripts/shell.ts';
      import '../scripts/clipboard.ts';
      import '../scripts/media-filter.ts';
      import '../scripts/media-sort.ts';
    </script>
  </body>
</html>
