---
import { getImage } from 'astro:assets';
import iambLogo from '../assets/profiles/iamb/logo.png';
import AppHeader from '../components/shell/AppHeader.astro';
import SearchDialog from '../components/search/SearchDialog.astro';
import ThemeBootstrap from '../components/shell/ThemeBootstrap.astro';
import { getDictionary } from '../i18n/index.ts';
import { inlineJson } from '../lib/inline-json.ts';
import { getPlayables } from '../lib/playable.ts';
import { resolveProfile } from '../lib/profile-context.ts';
import '../styles/tokens.css';
import '../styles/global.css';

const favicon = await getImage({
  src: iambLogo,
  width: 64,
  format: 'png',
});
const { profile } = resolveProfile('iamb');
const ui = getDictionary('de');
---

<!doctype html>
<html lang="de" data-profile="iamb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 - IAMB Synthmusic</title>
    <meta
      name="description"
      content="Diese Seite gibt es nicht. This page does not exist."
    />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" sizes="64x64" href={favicon.src} />
    <ThemeBootstrap />
  </head>
  <body>
    <AppHeader
      lang="de"
      profile="iamb"
      activeProfile={profile}
      page="home"
      ui={ui}
    />
    <main class="missing">
      <h1>404</h1>
      <p>Diese Seite gibt es nicht.</p>
      <p lang="en">This page does not exist.</p>
      <p class="links">
        <a href="/de/iamb/">Start</a>
        <a href="/en/iamb/" lang="en">
          Home
        </a>
      </p>
    </main>
    <SearchDialog lang="de" profile="iamb" ui={ui} />
    <script
      is:inline
      type="application/json"
      data-playables
      set:html={inlineJson(getPlayables(profile, 'iamb'))}
    />
    <script>
      import '../scripts/theme.ts';
      import '../scripts/search.ts';
      import '../scripts/shell.ts';
    </script>
  </body>
</html>

<style>
  body {
    background: var(--panel-ground);
  }

  .missing {
    display: grid;
    gap: var(--space-3);
    align-content: center;
    min-block-size: 100dvh;
    max-inline-size: 32rem;
    margin-inline: auto;
    padding: var(--space-6) var(--space-4);
  }

  h1 {
    font-variant-numeric: tabular-nums;
  }

  p {
    color: var(--legend-quiet);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-block-start: var(--space-2);
  }

  .links a {
    color: var(--legend);
    font-weight: 600;
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--ink);
  }
</style>
