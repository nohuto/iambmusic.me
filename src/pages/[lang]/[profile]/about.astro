---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { Language, ProfileId } from '../../../data/types.ts';
import { artist } from '../../../data/artist.ts';
import { getDictionary, localize } from '../../../i18n/index.ts';
import AppLayout from '../../../layouts/AppLayout.astro';
import { resolveProfile } from '../../../lib/profile-context.ts';
import { profileStaticPaths } from '../../../lib/routes.ts';

export const getStaticPaths = profileStaticPaths;

interface Props {
  lang: Language;
  profile: ProfileId;
}

const { lang, profile: profileId } = Astro.props;
const { profile } = resolveProfile(profileId);
const ui = getDictionary(lang);

const stories = await getCollection('profileStories');
const story = stories.find((entry) => entry.data.language === lang);
if (!story) throw new Error(`missing artist story for ${lang}`);
const { Content } = await render(story);
---

<AppLayout
  lang={lang}
  profile={profileId}
  activeProfile={profile}
  page="about"
  title={`${ui.nav.about} - ${profile.name}`}
  description={localize(profile.meta.about, lang)}
>
  <div class="about">
    <section class="intro">
      <h1>{story.data.heading}</h1>
      <p class="lead">{story.data.summary}</p>

      {story.data.status === 'provisional' && <p class="notice">{ui.notices.provisionalContent}</p>}

      <div class="bio">
        <Content />
      </div>
    </section>

    {
      artist.studio && (
        <section aria-labelledby="studio-heading">
          <h2 id="studio-heading">{ui.sections.studio}</h2>
          <div class="studio">
            <p>{localize(artist.studio.software, lang)}</p>
            <p>{localize(artist.studio.hardware, lang)}</p>
          </div>
        </section>
      )
    }

    {
      artist.timeline.length > 0 && (
        <section aria-labelledby="timeline-heading">
          <h2 id="timeline-heading">{ui.sections.timeline}</h2>
          <dl class="timeline">
            {artist.timeline.map((entry) => (
              <div class="moment">
                <dt>{entry.period}</dt>
                <dd>{localize(entry.text, lang)}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      artist.inspirations.length > 0 && (
        <section aria-labelledby="inspiration-heading">
          <h2 id="inspiration-heading">{ui.sections.inspiration}</h2>
          <ul class="inspirations">
            {artist.inspirations.map((inspiration) => (
              <li>
                <a href={inspiration.url} target="_blank" rel="noopener noreferrer">
                  <span class="shot">
                    <Image src={inspiration.image} alt="" width={240} loading="lazy" />
                  </span>
                  <span class="name">{inspiration.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</AppLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
    align-content: start;
    inline-size: 100%;
    max-inline-size: 48rem;
    margin-inline: auto;
  }

  .intro {
    display: grid;
    gap: var(--space-3);
  }

  .lead {
    color: var(--legend-quiet);
    font-size: var(--step-lead);
  }

  .notice {
    color: var(--legend-faint);
    font-size: var(--step-0);
  }

  .bio {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-2);
  }

  section h2 {
    font-size: var(--step-3);
  }

  .studio {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-3);
  }

  .studio p {
    color: var(--legend-quiet);
  }

  .timeline {
    display: grid;
    padding-block-start: var(--space-3);
  }

  .moment {
    display: grid;
    grid-template-columns: minmax(0, 5rem) minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
    border-block-start: var(--rule) solid var(--panel-rule);
  }

  .moment dt {
    color: var(--legend-faint);
    font-size: var(--step-0);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .inspirations {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-3);
    padding-block-start: var(--space-3);
    list-style: none;
  }

  .inspirations a {
    display: grid;
    gap: var(--space-2);
    color: var(--legend);
    font-size: var(--step-nav);
    font-weight: 600;
    text-decoration: none;
  }

  .shot {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-inner);
    overflow: hidden;
    background: var(--panel-recess);
  }

  .shot :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: filter 140ms ease;
  }

  .inspirations a:hover .shot :global(img),
  .inspirations a:focus-visible .shot :global(img) {
    filter: brightness(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .shot :global(img) {
      transition: none;
    }
  }

  @media (max-width: 30rem) {
    .moment {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
