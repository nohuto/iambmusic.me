---
import type { Language, ProfileId } from '../../../data/types.ts';
import { getDictionary, localize } from '../../../i18n/index.ts';
import AppLayout from '../../../layouts/AppLayout.astro';
import { resolveProfile } from '../../../lib/profile-context.ts';
import { profileStaticPaths } from '../../../lib/routes.ts';

export const getStaticPaths = profileStaticPaths;

interface Props {
  lang: Language;
  profile: ProfileId;
}

const { lang, profile: profileId } = Astro.props;
const { profile } = resolveProfile(profileId);
const ui = getDictionary(lang);
---

<AppLayout
  lang={lang}
  profile={profileId}
  activeProfile={profile}
  page="contact"
  title={`${ui.nav.contact} - ${profile.name}`}
  description={localize(profile.meta.contact, lang)}
>
  <section class="intro">
    <h1>{ui.nav.contact}</h1>
    <p class="address">
      <a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
    </p>
  </section>
</AppLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    max-inline-size: var(--measure);
  }

  .address {
    padding-block-start: var(--space-2);
    border-block-start: var(--rule) solid var(--panel-rule);
  }

  .address a {
    display: inline-block;
    color: var(--legend);
    font-size: var(--step-3);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .address a:hover,
  .address a:focus-visible {
    color: var(--ink);
  }
</style>
