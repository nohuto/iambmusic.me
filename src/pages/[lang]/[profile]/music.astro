---
import MediaTable from '../../../components/media/MediaTable.astro';
import MusicBanner from '../../../components/media/MusicBanner.astro';
import SourceFilter from '../../../components/media/SourceFilter.astro';
import type { Language, ProfileId } from '../../../data/types.ts';
import { getDictionary, localize } from '../../../i18n/index.ts';
import AppLayout from '../../../layouts/AppLayout.astro';
import { getMusicRows, getMusicSources } from '../../../lib/library.ts';
import { getProfileMedia } from '../../../lib/media.ts';
import { resolveProfile } from '../../../lib/profile-context.ts';
import { profileStaticPaths } from '../../../lib/routes.ts';

export const getStaticPaths = profileStaticPaths;

interface Props {
  lang: Language;
  profile: ProfileId;
}

const { lang, profile: profileId } = Astro.props;
const { profile } = resolveProfile(profileId);
const ui = getDictionary(lang);
const library = getProfileMedia(profileId);

const rows = getMusicRows(profile, profileId);
const sources = getMusicSources(profile, profileId);
---

<AppLayout
  lang={lang}
  profile={profileId}
  activeProfile={profile}
  page="music"
  title={`${ui.nav.music} - ${profile.name}`}
  description={localize(profile.meta.music, lang)}
>
  <MusicBanner
    lang={lang}
    ui={ui}
    library={library}
    heading={ui.nav.music}
    lead={ui.music.lead}
    rows={rows}
    sources={sources}
  />

  {sources.length > 0 && (
    <SourceFilter
      lang={lang}
      profile={profileId}
      page="music"
      ui={ui}
      sources={sources}
    />
  )}

  <MediaTable
    surface="music"
    rows={rows}
    profile={profile}
    lang={lang}
    ui={ui}
    heading={ui.nav.music}
  />
</AppLayout>
