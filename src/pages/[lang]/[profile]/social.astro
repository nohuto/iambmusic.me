---
import MediaTable from '../../../components/media/MediaTable.astro';
import MusicBanner from '../../../components/media/MusicBanner.astro';
import SourceFilter from '../../../components/media/SourceFilter.astro';
import type { Language, ProfileId } from '../../../data/types.ts';
import { getDictionary, localize } from '../../../i18n/index.ts';
import AppLayout from '../../../layouts/AppLayout.astro';
import { getSocialRows, getSocialSources, type SocialSource } from '../../../lib/library.ts';
import { getProfileMedia } from '../../../lib/media.ts';
import { resolveProfile } from '../../../lib/profile-context.ts';
import { profileStaticPaths } from '../../../lib/routes.ts';

export const getStaticPaths = profileStaticPaths;

interface Props {
  lang: Language;
  profile: ProfileId;
}

const { lang, profile: profileId } = Astro.props;
const { profile } = resolveProfile(profileId);
const ui = getDictionary(lang);
const library = getProfileMedia(profileId);

const rows = getSocialRows(profileId);
const sources = getSocialSources(profileId);
const requested = Astro.url.searchParams.get('source');
const active = sources.includes(requested as SocialSource) ? (requested as SocialSource) : null;
const visible = active ? rows.filter((row) => row.source === active) : rows;
---

<AppLayout
  lang={lang}
  profile={profileId}
  activeProfile={profile}
  page="social"
  title={`${ui.nav.social} - ${profile.name}`}
  description={localize(profile.meta.social, lang)}
  activeSource={active}
>
  <MusicBanner
    profileId={profileId}
    lang={lang}
    ui={ui}
    library={library}
    heading={ui.nav.social}
    lead={ui.social.lead}
    sources={sources}
  />

  {
    sources.length > 0 && (
      <SourceFilter
        lang={lang}
        profile={profileId}
        page="social"
        ui={ui}
        sources={sources}
        active={active}
      />
    )
  }

  <MediaTable surface="social" rows={visible} profile={profile} lang={lang} ui={ui} heading={ui.nav.social} />

</AppLayout>
