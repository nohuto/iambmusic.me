---
import { aimpProfile } from '../data/profiles/aimp.ts';
import { iambProfile } from '../data/profiles/iamb.ts';
import { languages } from '../data/types.ts';
import { dictionaries, localize } from '../i18n/index.ts';
import { absoluteUrl, defaultLanguage, routePath } from '../lib/routes.ts';

const profiles = [iambProfile, aimpProfile];
const title = 'IAMB Synthmusic & AiMP Music Project';
const description =
  'IAMB Synthmusic und AiMP Music Project von Markus B. - IAMB Synthmusic and AiMP Music Project by Markus B.';
---

<!doctype html>
<html lang={defaultLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl('/', Astro.site)} />
    {
      languages.map((lang) => (
        <link
          rel="alternate"
          hreflang={lang}
          href={absoluteUrl(routePath(lang, 'iamb', 'home'), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrl(routePath(defaultLanguage, 'iamb', 'home'), Astro.site)}
    />
  </head>
  <body>
    <main>
      <h1>{title}</h1>

      {
        languages.map((lang) => (
          <section lang={lang}>
            <h2>{dictionaries[lang].languageName}</h2>
            <ul>
              {profiles.map((profile) => (
                <li>
                  <a href={routePath(lang, profile.id, 'home')}>
                    {profile.name} - {dictionaries[lang].languageName}
                  </a>
                  <p>{localize(profile.hero.lead, lang)}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>
  </body>
</html>
